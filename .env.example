# Copy this file to .env and fill in real values. Never commit .env.

# --- Secrets ---
OPENAI_API_KEY=

# --- Models ---
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Cheap auxiliary calls: query classification, reranking, grounding checks.
# Kept separate so the answer model can be upgraded independently.
UTILITY_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.0

# --- Request reliability ---
# Without an explicit timeout the OpenAI SDK waits indefinitely, so one hung
# connection blocks its caller forever with no error.
REQUEST_TIMEOUT_SECONDS=45
REQUEST_MAX_RETRIES=3

# --- Chunking ---
# Children are embedded and searched; parents are what the model reads.
CHILD_CHUNK_SIZE=350
CHILD_CHUNK_OVERLAP=60
PARENT_CHUNK_SIZE=1600
# A line repeated on this fraction of a document's pages is treated as a
# running header/footer and stripped.
HEADER_FOOTER_MIN_PAGE_RATIO=0.6
# Legacy single-granularity path (kept for the chunk-size sweep).
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
# TOP_K is the DEFAULT and fallback only. Per-intent budgets live in
# backend/query_analysis.py, because a fact lookup and an exhaustive
# extraction need very different depths.
TOP_K=6
CANDIDATE_K=40
RRF_K=60
MAX_CHUNKS_PER_SOURCE=4
MAX_CONTEXT_TOKENS=6000

# --- Hierarchical retrieval (document routing) ---
ENABLE_DOC_ROUTING=true
DOC_ROUTING_CANDIDATES=60
# Relative gate: a document survives at this fraction of the leader's score.
# Absolute thresholds do not transfer across corpora or embedding models.
DOC_SCORE_DROP_RATIO=0.45
DOC_SCORE_TOP_CHUNKS=3
# Candidate slots reserved for chunks outside the routed documents, so a
# misclassified question cannot lose its bridging evidence entirely.
CROSS_DOC_RESERVE_SLOTS=3
SWEEP_MAX_CANDIDATES=60
RERANK_BATCH_SIZE=30

# --- Pipeline stages (each can be disabled for ablation) ---
ENABLE_HYBRID=true
ENABLE_RERANK=true
ENABLE_DECOMPOSITION=true
ENABLE_PARENT_EXPANSION=true
ENABLE_GROUNDING_CHECK=true

# --- Grounding remediation ---
# Detecting an unsupported claim and returning it anyway defeats the purpose.
ENABLE_GROUNDING_REPAIR=true
MAX_GROUNDING_REPAIRS=1

# --- Orchestration layer (additive, all OFF by default) ---
# Feature 1: extra document-routing signals (title, explicit reference,
# conversation focus, entity overlap) layered over the retriever's own scores.
ROUTER_ENABLED=false
ROUTER_SIGNAL_WEIGHT=0.35
ROUTER_PROTECT_RATIO=0.85
# Feature 2: recommendation planner for combination/workflow questions.
PLANNER_ENABLED=false
# Feature 3: outline-driven synthesis guaranteeing section coverage.
OUTLINE_SYNTHESIS_ENABLED=false

# --- Phase 2, Part B orchestration features (additive, all OFF by default) ---
# Measure flag-ON vs flag-OFF before trusting one:
#   .venv/bin/python -m scripts.eval_feature --flag <NAME>
# Feature 5: hard-lock retrieval to one named/focused document (stronger than
# ROUTER_ENABLED's score nudge). Never applied to multi_hop/cross_document.
DOC_LOCK_ENABLED=false
# Feature 6: when a grounding failure can't be safely repaired, fence the
# unverified part in the visible answer text instead of returning it unmarked.
PARTIAL_ANSWER_FENCING_ENABLED=false
# Feature 7: a question naming a whole-document artifact (guide, playbook,
# checklist, manual, SOP, onboarding, policy, journey, timeline) is upgraded
# to the synthesis (outline) profile even from a plain-lookup classification.
PLANNER_INTENT_EXPANSION_ENABLED=false
# Feature 8: "every X" / "all X" / "everything" forces the exhaustive (full
# sweep) profile regardless of how the classifier scored the question.
EXHAUSTIVE_TRIGGER_ENABLED=false

# --- Phase 4, Part A answer voice and structure (both ON by default) ---
# Prompt-side only: extra instructions to the answer model. Retrieval, ranking
# and citation building are untouched, and nothing reformats the model's output,
# so neither flag can move a figure. They default ON rather than OFF -- the
# phase's acceptance gate is that answers read warm and are shaped to their
# content, and an OFF default would ship a system that passes review by not
# doing the thing. Set either false to revert to Phase 3 answer text.
#
# Warm human register: contractions, direct address, no corporate stock
# phrases. Wording only -- it may not add a fact, a reassurance or a caveat,
# and it may not decorate or soften the fixed refusal sentence.
ANSWER_VOICE_ENABLED=true
# Structure follows content: a table for comparisons and repeated-attribute
# lists, bullets for steps and enumerations, prose for explanations. The model
# picks; the client renders markdown into shadcn table/list components.
ANSWER_FORMAT_ENABLED=true

# --- V3.1: markdown ingestion and semantic (heading-aware) splitting ---
#
# OFF by default. With it off, ingestion is the V2 plain-text pipeline exactly:
# same extractor, same cleaner, same chunker, and the new metadata keys
# (heading_path, section_title, extraction_mode) carry V2-neutral values.
#
# ON converts each PDF to markdown (pymupdf4llm) first, then splits in two
# stages -- headings first, the existing character splitter only for sections
# still over the ~800/120 budget -- so a boundary lands on a real section break.
# The plain-text path stays available and is the automatic fallback for a
# scanned / image-only PDF, which is then flagged extraction_mode="text".
#
# Flipping this changes each document's content hash on purpose: the chunk
# stream differs, so the "unchanged, skipped" check MUST re-ingest.
MARKDOWN_INGESTION_ENABLED=false
# Heading levels the first stage cuts on. Past three, a "section" is usually one
# sentence, and a one-sentence chunk retrieves worse than its parent paragraph.
MARKDOWN_HEADER_LEVELS=3
# Threshold for stage two, in tokens. 0 means "use CHUNK_SIZE" -- the LOCKED
# ~800/120 budget, not a new tunable.
MARKDOWN_SECTION_MAX_TOKENS=0
# Fallback triggers: fewer than this many markdown characters, or markdown that
# recovers less than this fraction of what the plain-text extractor found.
MARKDOWN_MIN_CHARS=200
MARKDOWN_MIN_TEXT_RATIO=0.5
# Where generated markdown is cached, namespaced per owner underneath.
MARKDOWN_DIR=data/markdown

# --- V3.2: table-aware ingestion and sibling expansion ---
#
# OFF by default. With it off, tables behave exactly as in V2: each detected
# table is rendered as one pipe-delimited block inside the normal chunk stream,
# and a table crossing a page break becomes two unrelated chunks -- the second
# with no header row, so nothing in it says what its columns mean.
#
# ON lifts tables out of the text stream: extracted structurally, stitched across
# page breaks into one logical table, chunked on ROW boundaries with the column
# headers repeated in every part, and tagged with a shared table_id. A hit on any
# part then reassembles the whole table by METADATA FETCH -- no second search.
# Each table also gets a one-line summary chunk so it can be found by meaning
# rather than by matching a query against pipe-delimited digits.
#
# Only documents that actually contain tables are re-ingested when this flips.
TABLE_AWARE_INGESTION_ENABLED=false
# Token budget per table part. 0 means "use CHUNK_SIZE" -- the LOCKED ~800/120
# budget. There is no overlap setting: overlap is meaningless between rows, and
# repeating the header block is what a row fragment actually needs.
TABLE_CHUNK_MAX_TOKENS=0
# Ceilings on sibling expansion, so a hit on one part of a 40-part table cannot
# evict every other document from the context window. Past either cap the prompt
# gets the header block, the one-line summary, and the parts that matched.
TABLE_SIBLING_MAX_PARTS=6
TABLE_SIBLING_MAX_TOKENS=3000
# Row labels (first-column values) listed in a table's summary. Labels are what a
# question names, so they drive retrieval. Cell VALUES are never summarised: a
# summary is generated text and an answer must not be able to take a figure from
# it.
TABLE_SUMMARY_MAX_LABELS=12

# --- V3.3: the universal metadata layer ---
#
# Metadata is a headline V3 feature, so unlike every other V3 flag these ship ON.
# The flags remain so each layer can be measured against itself; the default is
# the shipped state, not the reverted one.
#
# EVERY chunk carries the full 15-field contract in backend/chunk_schema.py
# regardless of these flags -- text chunks, table parts, table summaries and
# plain-text fallback chunks alike. A field may be empty; it may never be absent,
# because a Chroma `where` clause on a key only some chunks carry silently
# under-returns instead of erroring.
#
# Layer B: one batched gpt-4o-mini call per group of chunks at INGEST, filling
# content_type / topics / entities / answers_questions. Query time is untouched.
# These four are FILTER-ONLY: they join the keyword index and never the prompt, so
# a wrong auto-tag cannot reach the answer model.
SEMANTIC_METADATA_ENABLED=true
SEMANTIC_METADATA_BATCH_SIZE=8
SEMANTIC_METADATA_CHARS=1200

# Layer C: read the per-document manifest (heading tree + aggregated topics and
# entities, in SQLite) to drive enumeration questions and heading filters.
MANIFEST_ROUTING_ENABLED=true
# Minimum items before the manifest overrides ordinary retrieval. One is not a set.
MANIFEST_MIN_ITEMS=2
# Ceiling on items one enumeration drives retrieval for; past this the answer
# reports how many of how many rather than truncating silently.
MANIFEST_MAX_ITEMS=25
# Regenerate ONCE naming what an enumeration answer missed. This is the
# anti-silent-incompleteness step: 3 of 7 items reads exactly like 7 of 7.
MANIFEST_COVERAGE_REPAIR=true

# Narrow the candidate pool by heading_path BEFORE searching when a question names
# a section ("what does the eligibility section say?"). Measured: 396 chunks -> 9.
HEADING_FILTER_ENABLED=true
# A filter matching more than this share of the corpus has narrowed nothing and
# can only exclude something relevant, so it is dropped.
HEADING_FILTER_MAX_SHARE=0.5

# Raise on a chunk violating the metadata contract instead of logging. OFF in
# production -- refusing to index a chunk over a missing optional label trades a
# complete index for a tidy one -- and ON in tests and the verifier.
CHUNK_SCHEMA_STRICT=false

# --- Addendum 2: parallel SQL + vector table retrieval ---
#
# OFF by default. When ON, every table cell is ALSO stored relationally in SQLite
# at ingest, and a question that looks like it names a cell fires an indexed SQL
# lookup ALONGSIDE the full hybrid pipeline -- never instead of it. Vector
# retrieval always runs; SQL is speculative and is used only when it is
# confidently correct, so a wrong guess costs nothing but a millisecond on
# another thread.
#
# The two decisions are deliberately asymmetric:
#   * Decision 1 (fire?)  PERMISSIVE -- ~1ms, no API call, runs concurrently.
#   * Decision 2 (trust?) STRICT     -- a wrong value stated authoritatively is
#     worse than no value, because the reader cannot tell it from a right one.
PARALLEL_SQL_LOOKUP_ENABLED=false

# Decision 1's fuzzy floor: how closely a query phrase must resemble a known
# column name or row label before a lookup is worth 1ms. Below the trust floor
# on purpose -- this gate decides whether to SPEND, not whether to believe.
PARALLEL_SQL_FIRE_THRESHOLD=78
# Decision 2's floor, applied to BOTH the entity and the column match.
PARALLEL_SQL_TRUST_THRESHOLD=85

# MAX/MIN/COUNT and simple numeric filters ("who scored highest in Math"), which
# vector search is genuinely poor at because no passage states the answer.
PARALLEL_SQL_AGGREGATES_ENABLED=true
# A filter aggregate legitimately returns a SET, so the single-value rule cannot
# apply. Past this many rows the result is a report, not a fact, and is dropped.
PARALLEL_SQL_MAX_FILTER_ROWS=20
# Cells stored per document, so one pathological table cannot slow every ingest.
PARALLEL_SQL_MAX_CELLS_PER_DOC=20000

# --- Storage ---
CHROMA_DIR=chroma_store
CHROMA_COLLECTION=smartdoc
# Explicit distance metric. Chroma's own default is l2, whose 0-4 scale
# silently invalidates any threshold tuned against cosine's 0-2.
CHROMA_SPACE=cosine

# --- API hardening ---
MAX_UPLOAD_MB=20
MAX_QUESTION_CHARS=4000

# --- Service wiring ---
BACKEND_URL=http://127.0.0.1:8000

# ===========================================================================
# V2 -- relational store, authentication, per-user isolation
# ===========================================================================

# SQLite owns users, documents, sessions, and messages. Chroma keeps only
# vectors and their metadata; the two are joined on document_id.
SQLITE_PATH=smartdoc.db

# Master switch for the multi-tenant layer. ON by default. Setting it false
# reverts to V1 single-user behaviour (no scope applied anywhere) -- the escape
# hatch if something in the new layer misbehaves.
MULTI_USER_ENABLED=true

# --- JWT ---
# MUST be set to a real random value before this API is reachable by anyone
# else: a known signing key lets anyone mint a token for any user_id, which
# defeats every isolation guarantee below. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Startup warns about the placeholder secret rather than refusing; set this to
# false to make an unset JWT_SECRET a hard startup failure.
ALLOW_INSECURE_JWT_SECRET=true

# bcrypt cost. Each +1 doubles login CPU time.
BCRYPT_ROUNDS=12

# --- Google OAuth (authlib) ---
# Optional: leaving these blank disables only the Google routes. Email/password
# sign-in keeps working, so the app still runs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Where to send the browser after a successful Google sign-in; the JWT is
# appended as ?token=... Leave blank to return the token as JSON instead.
# For the Next.js client this MUST point at its callback route, or the token is
# rendered as raw JSON in the browser instead of signing the user in:
#   OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback
OAUTH_SUCCESS_REDIRECT=
# Signs the short-lived OAuth state cookie. Separate from JWT_SECRET so
# rotating one does not invalidate the other.
SESSION_SECRET=

# --- Seeded development account ---
# `python -m scripts.seed_dev_user` creates this user and adopts every
# pre-V2 chunk into it, so the existing corpus stays queryable.
DEV_USER_EMAIL=dev@smartdoc.local
DEV_USER_PASSWORD=devpassword123
DEV_USER_ID=dev-user-0001

# ===========================================================================
# V2 Phase 3 -- the Next.js frontend
# ===========================================================================

# Browser origins allowed to call this API, comma-separated. Replaces Phase 1's
# `*`: authorization is a bearer header rather than a cookie, so the wildcard was
# not an ambient-session risk -- but it did let any page on the machine replay a
# token it had scraped. Both spellings of localhost are listed because Next.js
# serves on `localhost` while the API's defaults use `127.0.0.1`, and the browser
# treats them as different origins.
#
# Changing the frontend's port means changing this too, or every call is blocked.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend build-time variable (web/.env.local, NOT this file) ---
# The browser talks to the API directly, so the client bundle needs its address.
# `NEXT_PUBLIC_` variables are inlined into the bundle at build time and are
# therefore PUBLIC -- never put a secret behind that prefix. Set it in
# web/.env.local (see web/.env.example):
#
#   NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Streamlit demo client (streamlit_demo/) ---
# A second, basic UI that talks to this same API over HTTP. It signs in as ONE
# pre-existing account, with no login screen.
#
# The demo account signed up through Google and therefore has no password, so
# /auth/login cannot be used for it. A token is instead minted LOCALLY by
# scripts/mint_demo_token.py, which reads the user row from SQLite and calls the
# same create_access_token() that /auth/login uses internally. Run it before a
# demo; it writes a git-ignored .demo_token that the Streamlit app reads:
#
#   python scripts/mint_demo_token.py
#   streamlit run streamlit_demo/app.py
#
# There is deliberately NO endpoint that mints tokens for an arbitrary account --
# anything reachable over the network that hands out credentials is an
# authentication bypass.
DEMO_USER_EMAIL=your-demo-account@example.com

# Only needed if the demo account uses email/password rather than Google. The
# Google account above does not, which is why the local mint script exists.
DEMO_USER_PASSWORD=replace-me

# Where the Streamlit client should reach the API. Defaults to the local backend.
DEMO_API_BASE_URL=http://127.0.0.1:8000
