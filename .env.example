# Copy this file to .env and fill in real values. Never commit .env.

# --- Secrets ---
OPENAI_API_KEY=

# --- Models ---
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Cheap auxiliary calls: query classification, reranking, grounding checks.
# Kept separate so the answer model can be upgraded independently.
UTILITY_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.0

# --- Request reliability ---
# Without an explicit timeout the OpenAI SDK waits indefinitely, so one hung
# connection blocks its caller forever with no error.
REQUEST_TIMEOUT_SECONDS=45
REQUEST_MAX_RETRIES=3

# --- Chunking ---
# Children are embedded and searched; parents are what the model reads.
CHILD_CHUNK_SIZE=350
CHILD_CHUNK_OVERLAP=60
PARENT_CHUNK_SIZE=1600
# A line repeated on this fraction of a document's pages is treated as a
# running header/footer and stripped.
HEADER_FOOTER_MIN_PAGE_RATIO=0.6
# Legacy single-granularity path (kept for the chunk-size sweep).
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
# TOP_K is the DEFAULT and fallback only. Per-intent budgets live in
# backend/query_analysis.py, because a fact lookup and an exhaustive
# extraction need very different depths.
TOP_K=6
CANDIDATE_K=40
RRF_K=60
MAX_CHUNKS_PER_SOURCE=4
MAX_CONTEXT_TOKENS=6000

# --- Hierarchical retrieval (document routing) ---
ENABLE_DOC_ROUTING=true
DOC_ROUTING_CANDIDATES=60
# Relative gate: a document survives at this fraction of the leader's score.
# Absolute thresholds do not transfer across corpora or embedding models.
DOC_SCORE_DROP_RATIO=0.45
DOC_SCORE_TOP_CHUNKS=3
# Candidate slots reserved for chunks outside the routed documents, so a
# misclassified question cannot lose its bridging evidence entirely.
CROSS_DOC_RESERVE_SLOTS=3
SWEEP_MAX_CANDIDATES=60
RERANK_BATCH_SIZE=30

# --- Pipeline stages (each can be disabled for ablation) ---
ENABLE_HYBRID=true
ENABLE_RERANK=true
ENABLE_DECOMPOSITION=true
ENABLE_PARENT_EXPANSION=true
ENABLE_GROUNDING_CHECK=true

# --- Grounding remediation ---
# Detecting an unsupported claim and returning it anyway defeats the purpose.
ENABLE_GROUNDING_REPAIR=true
MAX_GROUNDING_REPAIRS=1

# --- Orchestration layer (additive, all OFF by default) ---
# Feature 1: extra document-routing signals (title, explicit reference,
# conversation focus, entity overlap) layered over the retriever's own scores.
ROUTER_ENABLED=false
ROUTER_SIGNAL_WEIGHT=0.35
ROUTER_PROTECT_RATIO=0.85
# Feature 2: recommendation planner for combination/workflow questions.
PLANNER_ENABLED=false
# Feature 3: outline-driven synthesis guaranteeing section coverage.
OUTLINE_SYNTHESIS_ENABLED=false

# --- Phase 2, Part B orchestration features (additive, all OFF by default) ---
# Measure flag-ON vs flag-OFF before trusting one:
#   .venv/bin/python -m scripts.eval_feature --flag <NAME>
# Feature 5: hard-lock retrieval to one named/focused document (stronger than
# ROUTER_ENABLED's score nudge). Never applied to multi_hop/cross_document.
DOC_LOCK_ENABLED=false
# Feature 6: when a grounding failure can't be safely repaired, fence the
# unverified part in the visible answer text instead of returning it unmarked.
PARTIAL_ANSWER_FENCING_ENABLED=false
# Feature 7: a question naming a whole-document artifact (guide, playbook,
# checklist, manual, SOP, onboarding, policy, journey, timeline) is upgraded
# to the synthesis (outline) profile even from a plain-lookup classification.
PLANNER_INTENT_EXPANSION_ENABLED=false
# Feature 8: "every X" / "all X" / "everything" forces the exhaustive (full
# sweep) profile regardless of how the classifier scored the question.
EXHAUSTIVE_TRIGGER_ENABLED=false

# --- Storage ---
CHROMA_DIR=chroma_store
CHROMA_COLLECTION=smartdoc
# Explicit distance metric. Chroma's own default is l2, whose 0-4 scale
# silently invalidates any threshold tuned against cosine's 0-2.
CHROMA_SPACE=cosine

# --- API hardening ---
MAX_UPLOAD_MB=20
MAX_QUESTION_CHARS=4000

# --- Service wiring ---
BACKEND_URL=http://127.0.0.1:8000

# ===========================================================================
# V2 -- relational store, authentication, per-user isolation
# ===========================================================================

# SQLite owns users, documents, sessions, and messages. Chroma keeps only
# vectors and their metadata; the two are joined on document_id.
SQLITE_PATH=smartdoc.db

# Master switch for the multi-tenant layer. ON by default. Setting it false
# reverts to V1 single-user behaviour (no scope applied anywhere) -- the escape
# hatch if something in the new layer misbehaves.
MULTI_USER_ENABLED=true

# --- JWT ---
# MUST be set to a real random value before this API is reachable by anyone
# else: a known signing key lets anyone mint a token for any user_id, which
# defeats every isolation guarantee below. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Startup warns about the placeholder secret rather than refusing; set this to
# false to make an unset JWT_SECRET a hard startup failure.
ALLOW_INSECURE_JWT_SECRET=true

# bcrypt cost. Each +1 doubles login CPU time.
BCRYPT_ROUNDS=12

# --- Google OAuth (authlib) ---
# Optional: leaving these blank disables only the Google routes. Email/password
# sign-in keeps working, so the app still runs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Where to send the browser after a successful Google sign-in; the JWT is
# appended as ?token=... Leave blank to return the token as JSON instead.
OAUTH_SUCCESS_REDIRECT=
# Signs the short-lived OAuth state cookie. Separate from JWT_SECRET so
# rotating one does not invalidate the other.
SESSION_SECRET=

# --- Seeded development account ---
# `python -m scripts.seed_dev_user` creates this user and adopts every
# pre-V2 chunk into it, so the existing corpus stays queryable.
DEV_USER_EMAIL=dev@smartdoc.local
DEV_USER_PASSWORD=devpassword123
DEV_USER_ID=dev-user-0001
